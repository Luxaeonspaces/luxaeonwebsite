generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Activity {
  id         String   @id
  entityType String?
  entityId   String?
  activity   String
  createdAt  DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Appraisal {
  id                 String   @id
  userId             String
  employeeName       String
  department         String?
  period             String
  quarter            String?
  year               Int?
  selfQuality        Int      @default(0)
  selfTeamwork       Int      @default(0)
  selfReliability    Int      @default(0)
  selfInitiative     Int      @default(0)
  selfCommunication  Int      @default(0)
  selfOverall        Float    @default(0)
  selfKpis           String?
  selfStrengths      String?
  selfImprovements   String?
  selfGoals          String?
  selfSalesTarget    Float?
  selfSalesAchieved  Float?
  selfSubmittedAt    String?
  hodReviewer        String?
  hodNote            String?
  hodApprovedAt      String?
  qualityScore       Int      @default(0)
  teamworkScore      Int      @default(0)
  reliabilityScore   Int      @default(0)
  initiativeScore    Int      @default(0)
  communicationScore Int      @default(0)
  overallScore       Float    @default(0)
  strengths          String?
  improvements       String?
  goals              String?
  hrNote             String?
  hrReviewer         String?
  hrApprovedAt       String?
  founderNote        String?
  founderApprover    String?
  founderApprovedAt  String?
  employeeComment    String?
  status             String   @default("Self Draft")
  createdAt          DateTime @default(now())
  updatedAt          DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model AuditLog {
  id         String   @id
  username   String?
  fullName   String?
  role       String?
  department String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ClientDocument {
  id             String   @id
  projectCode    String
  filename       String
  originalName   String?
  uploadedBy     String?
  uploadedByRole String?  @default("staff")
  description    String?
  createdAt      DateTime @default(now())
  Project        Project  @relation(fields: [projectCode], references: [projectCode])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model EmployeeDocument {
  id           String   @id
  userId       String
  filename     String
  originalName String?
  category     String?  @default("General")
  description  String?
  uploadedBy   String?
  createdAt    DateTime @default(now())
  User         User     @relation(fields: [userId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Lead {
  id           String   @id
  fullName     String
  phone        String?
  email        String?
  location     String?
  projectType  String?
  budgetRange  String?
  source       String?
  status       String   @default("New")
  notes        String?
  nextFollowup String?
  ownerUserId  String?
  ownerName    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model LeaveRequest {
  id            String   @id
  userId        String
  employeeName  String
  department    String?
  startDate     String
  endDate       String
  days          Float
  reason        String?
  status        String   @default("Pending HOD")
  hodApprovedBy String?
  hodNote       String?
  hodDate       String?
  hrApprovedBy  String?
  hrNote        String?
  hrDate        String?
  year          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OnboardingChecklist {
  id                 String   @id
  userId             String
  employeeName       String
  status             String   @default("In Progress")
  offerLetter        Boolean  @default(false)
  contractSigned     Boolean  @default(false)
  idCollected        Boolean  @default(false)
  bankDetails        Boolean  @default(false)
  systemAccess       Boolean  @default(false)
  orientation        Boolean  @default(false)
  toolsIssued        Boolean  @default(false)
  policyAcknowledged Boolean  @default(false)
  mentorAssigned     Boolean  @default(false)
  notes              String?
  startedBy          String?
  completedBy        String?
  startedAt          DateTime @default(now())
  completedAt        String?
  updatedAt          DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OutflowDocument {
  id             String         @id
  outflowId      String
  filename       String
  originalName   String?
  uploadedBy     String?
  createdAt      DateTime       @default(now())
  OutflowRequest OutflowRequest @relation(fields: [outflowId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model OutflowRequest {
  id                String            @id
  requestedBy       String
  requestedById     String?
  department        String?
  description       String
  category          String?
  amount            Float
  vendor            String?
  projectCode       String?
  payeeName         String?
  payeeBankName     String?
  payeeAccountNo    String?
  payeeAccountName  String?
  status            String            @default("Pending Department")
  deptApprovedBy    String?
  deptNote          String?
  deptDate          String?
  finalApprovedBy   String?
  finalNote         String?
  finalDate         String?
  financeReleasedBy String?
  financeNote       String?
  financeDate       String?
  linkedTxnId       String?
  requestDate       DateTime          @default(now())
  OutflowDocument   OutflowDocument[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PayrollBatch {
  id                String          @id
  period            String
  status            String          @default("Draft")
  totalNet          Float           @default(0)
  employeeCount     Int             @default(0)
  preparedBy        String?
  founderApprovedBy String?
  founderApprovedAt String?
  paidBy            String?
  paidAt            String?
  linkedTxnId       String?
  createdAt         DateTime        @default(now())
  PayrollRecord     PayrollRecord[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PayrollRecord {
  id           String        @id
  batchId      String?
  userId       String
  employeeName String
  period       String
  basicSalary  Float
  allowances   Float         @default(0)
  deductions   Float         @default(0)
  netPay       Float
  status       String        @default("Draft")
  preparedBy   String?
  approvedBy   String?
  approvedAt   String?
  paidBy       String?
  paidAt       String?
  linkedTxnId  String?
  notes        String?
  createdAt    DateTime      @default(now())
  PayrollBatch PayrollBatch? @relation(fields: [batchId], references: [id])
  User         User          @relation(fields: [userId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProcurementDocument {
  id                 String             @id
  procurementId      String
  filename           String
  originalName       String?
  uploadedBy         String?
  createdAt          DateTime           @default(now())
  ProcurementRequest ProcurementRequest @relation(fields: [procurementId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProcurementRequest {
  id                  String                @id
  projectCode         String?
  title               String
  description         String?
  category            String?
  estimatedCost       Float                 @default(0)
  vendorPreferred     String?
  payeeName           String?
  payeeBankName       String?
  payeeAccountNo      String?
  payeeAccountName    String?
  requestedBy         String
  requestedById       String?
  department          String?
  status              String                @default("Pending Procurement HOD")
  procurementNote     String?
  processedBy         String?
  processedAt         String?
  hodApprovedBy       String?
  hodNote             String?
  hodDate             String?
  founderApprovedBy   String?
  founderNote         String?
  founderDate         String?
  financeReleasedBy   String?
  financeNote         String?
  financeDate         String?
  linkedTxnId         String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime
  ProcurementDocument ProcurementDocument[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Project {
  id               String           @id
  projectCode      String           @unique
  clientName       String
  projectName      String?
  location         String?
  stage            String           @default("Lead")
  startDate        String?
  targetHandover   String?
  designFee        Float            @default(0)
  amountPaid       Float            @default(0)
  status           String           @default("Active")
  notes            String?
  clientAccessCode String?
  createdBy        String?
  salesPersonId    String?
  salesPersonName  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime
  ClientDocument   ClientDocument[]
  ProjectFile      ProjectFile[]
  ProjectNote      ProjectNote[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProjectFile {
  id           String   @id
  projectCode  String
  filename     String
  originalName String?
  uploadedBy   String?
  category     String?  @default("General")
  description  String?
  createdAt    DateTime @default(now())
  Project      Project  @relation(fields: [projectCode], references: [projectCode])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProjectNote {
  id        String   @id
  projectId String
  note      String
  createdBy String?
  createdAt DateTime @default(now())
  Project   Project  @relation(fields: [projectId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model SalesTarget {
  id             String   @id
  userId         String
  employeeName   String
  period         String
  targetAmount   Float
  achievedAmount Float    @default(0)
  leadsTarget    Int      @default(0)
  leadsAchieved  Int      @default(0)
  notes          String?
  setBy          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model StaffProfile {
  id                    String   @id
  userId                String   @unique
  employeeId            String?
  phone                 String?
  email                 String?
  address               String?
  jobTitle              String?
  dateJoined            String?
  bankName              String?
  bankAccount           String?
  salaryAmount          Float    @default(0)
  notes                 String?
  dateOfBirth           String?
  gender                String?
  maritalStatus         String?
  nationality           String?
  stateOfOrigin         String?
  nin                   String?
  nokName               String?
  nokRelationship       String?
  nokPhone              String?
  nokEmail              String?
  nokAddress            String?
  spouseName            String?
  spousePhone           String?
  spouseEmail           String?
  spouseOccupation      String?
  guarantorName         String?
  guarantorPhone        String?
  guarantorEmail        String?
  guarantorAddress      String?
  guarantorOccupation   String?
  guarantorRelationship String?
  healthStatus          String?
  healthHistory         String?
  bloodGroup            String?
  allergies             String?
  disabilities          String?
  workExperience        String?
  skills                String?
  educationHistory      String?
  certifications        String?
  updatedAt             DateTime
  User                  User     @relation(fields: [userId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Transaction {
  id                  String                @id
  txnId               String                @unique
  type                String
  category            String?
  description         String?
  amount              Float
  projectCode         String?
  salesPersonId       String?
  salesPersonName     String?
  clientName          String?
  date                String
  createdBy           String?
  createdAt           DateTime              @default(now())
  TransactionDocument TransactionDocument[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TransactionAudit {
  id            String   @id
  transactionId String?
  txnId         String?
  action        String
  details       String?
  performedBy   String?
  performedById String?
  role          String?
  department    String?
  createdAt     DateTime @default(now())
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model TransactionDocument {
  id            String      @id
  transactionId String
  filename      String
  originalName  String?
  category      String?     @default("Invoice")
  uploadedBy    String?
  createdAt     DateTime    @default(now())
  Transaction   Transaction @relation(fields: [transactionId], references: [id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model User {
  id               String             @id
  username         String             @unique
  fullName         String
  passwordHash     String
  role             String
  department       String?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  EmployeeDocument EmployeeDocument[]
  PayrollRecord    PayrollRecord[]
  StaffProfile     StaffProfile?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Vendor {
  id            String  @id
  name          String
  category      String?
  contactPerson String?
  phone         String?
  email         String?
  location      String?
  reliability   Int     @default(3)
  quality       Int     @default(3)
  priceLevel    String?
  notes         String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model WorkActivity {
  id         String   @id
  userId     String?
  username   String?
  fullName   String
  department String?
  role       String?
  action     String
  entityType String?
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())
}
